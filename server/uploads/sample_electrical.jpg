<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="100%" height="100%">
  <rect width="800" height="600" fill="#0f172a"/>
  
  <!-- Electrical Panel Cabinet -->
  <rect x="150" y="80" width="500" height="440" fill="#334155" stroke="#64748b" stroke-width="4" rx="8"/>
  <rect x="180" y="110" width="440" height="380" fill="#1e293b" stroke="#475569" stroke-width="2"/>
  
  <!-- Circuit Breaker Blocks -->
  <rect x="220" y="150" width="140" height="70" fill="#475569" rx="4"/>
  <rect x="220" y="240" width="140" height="70" fill="#dc2626" rx="4"/>
  <rect x="220" y="330" width="140" height="70" fill="#475569" rx="4"/>
  
  <!-- Singed Damaged Wire -->
  <path d="M 360 275 Q 450 220 520 310" stroke="#7f1d1d" stroke-width="10" fill="none"/>
  <path d="M 360 275 Q 450 220 520 310" stroke="#ef4444" stroke-dasharray="6 6" stroke-width="6" fill="none"/>
  
  <!-- Carbon Charring Smoke -->
  <circle cx="430" cy="255" r="40" fill="#dc2626" opacity="0.4"/>
  <path d="M 420 230 L 440 210 L 425 245 L 450 225 L 430 270" stroke="#fef08a" stroke-width="3" fill="none"/>

  <!-- AI Target Bounding Box -->
  <rect x="330" y="200" width="220" height="150" fill="none" stroke="#dc2626" stroke-width="3" stroke-dasharray="8 4"/>
  <rect x="330" y="165" width="240" height="30" fill="#dc2626" rx="4"/>
  <text x="340" y="185" fill="#ffffff" font-family="sans-serif" font-size="14" font-weight="bold">HAZARD: ARC SCORCH (96%)</text>
</svg>
